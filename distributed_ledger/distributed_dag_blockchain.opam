  "ocaml" {>= "5.2"}
  "lwt"
  "digestif"
  "grpc-lwt"
  "mirage-crypto-pk"
  "mirage-crypto-rng"
  "ocaml-protoc"
  "pbrt"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
